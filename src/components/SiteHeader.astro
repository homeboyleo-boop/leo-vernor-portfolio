---
// The big name and the menu, shared by every page.
// To add a page to the menu, add it to `links` below.
interface Props {
  current?: 'home' | 'photography';
}
const { current } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const links = [
  { id: 'photography', label: 'Photos', href: `${base}photography/` },
];
---

<header class="site-header">
  {current === 'home'
    ? <h1 class="name">Leo Vernor</h1>
    : <p class="name"><a href={base} aria-label="Leo Vernor, home">Leo Vernor</a></p>}
  <nav class="menu" aria-label="Main">
    <ul>
      {links.map((l) => (
        <li>
          <a href={l.href} aria-current={current === l.id ? 'page' : undefined}>{l.label}</a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .site-header {
    padding: var(--gutter) var(--gutter) 0;
  }

  /* The name, set across about half the width. */
  .name {
    margin: 0;
    font-family: var(--display);
    font-weight: 800;
    font-size: max(2.75rem, calc((100vw - 2 * var(--gutter)) * 0.12));
    font-variation-settings: 'opsz' 72;
    line-height: 0.78;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    white-space: nowrap;
    margin-inline: -0.035em;
  }
  .name a { text-decoration: none; }

  .menu ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.75rem;
    margin: 1.1rem 0 0;
    padding: 0;
    list-style: none;
    font-size: clamp(var(--step-1), 1.9vw, 2.1rem);
    line-height: 1.3;
  }
  .menu a { text-decoration: none; }
  .menu a:hover,
  .menu a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
  }
</style>
