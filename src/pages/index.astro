---
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
// To change the home photo, replace this file (keep the name) or point this line at another one.
import background from '../assets/home/websitebackground.jpg';

const bg = await getImage({ src: background, widths: [800, 1400, 2048] });
---

<Base title="Leo Vernor" description="Leo Vernor: photography.">
  <div class="home">
    <img
      class="background"
      src={bg.src}
      srcset={bg.srcSet.attribute}
      sizes="100vw"
      width={background.width}
      height={background.height}
      alt="Tall grass blurred by wind beneath a pale, empty sky"
      fetchpriority="high"
    />
    <SiteHeader current="home" />
  </div>
</Base>

<style>
  .home {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    overflow: hidden;
    background: #d9d9d6; /* close to the photo's sky, shown while it loads */
  }

  .background {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Keep the horizon in view however the screen is shaped. */
    object-position: 50% 58%;
  }

  /* The name and menu sit on the pale sky. */
  .home :global(.site-header) {
    position: relative;
  }
</style>
